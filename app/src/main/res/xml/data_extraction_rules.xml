<?xml version="1.0" encoding="utf-8"?>
<!-- Nova AI keys are encrypted with a key that never leaves this unit: don't back up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nova_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_ai.xml" />
    </device-transfer>
</data-extraction-rules>
